# Documentation only: set these variables in the shell before yarn dev.
PANDAUI_FRONTEND_PORT=9002
# Optional separately operated backend; no backend connection by default.
# PANDAUI_BACKEND_URL=http://127.0.0.1:9001
# Optional compatible OCCT JS/WASM build (absolute folder outside the repository).
# PANDAUI_OCCT_RUNTIME_DIR=/path/to/custom/occt/dist
